{
  "name": "@kyc-compliance/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/vite/bin/vite.js",
    "build": "node ../node_modules/typescript/bin/tsc -b && node ../node_modules/vite/bin/vite.js build && npm run build:widget",
    "build:widget": "node ../node_modules/vite/bin/vite.js build --config vite.widget.config.ts && node ../node_modules/typescript/bin/tsc --project tsconfig.widget.json",
    "typecheck": "node ../node_modules/typescript/bin/tsc -b --pretty"
  },
  "exports": {
    "./widget": {
      "types": "./dist-widget/types/widget.d.ts",
      "import": "./dist-widget/veritrust-widget.js"
    },
    "./widget.css": "./dist-widget/veritrust-widget.css"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "axios": "^1.21.1",
    "lucide-react": "^1.74.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
